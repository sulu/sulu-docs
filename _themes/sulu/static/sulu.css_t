{% set page_width = '940px' %}
{% set sidebar_width = '210px' %}
{% set sidebar_gutter_width = '48px' %}

@import url("basic.css");

*,
*::before,
*::after {
    box-sizing: border-box;
}

:root {
    --accent-color: #112a46;
    --body-bg: white;
    --body-color: #112a46;
    --nav-color: #112a46;
    --nav-hover-color: #52B6CA;
    --link-color: #52B6CA;
    --link-hover-color: #52B6CA;
    --border-color: #e7e9ec;
    --code-bg: #eee;
    --admonition-bg: rgba(204, 204, 204, 0.25);
    --warning-bg: rgba(255, 204, 0, 0.25);
}

html[data-theme=dark] {
    --body-bg: #151b2a;
    --body-color: #f5f5f5;
    --nav-color: #ddd;
    --nav-hover-color: #52B6CA;
    --link-color: #52B6CA;
    --link-hover-color: #52B6CA;
    --border-color: #222223;
    --code-bg: #000;
    --admonition-bg: rgba(204, 204, 204, 0.25);
    --warning-bg: rgba(255, 204, 0, 0.25);
    color-scheme: dark;

    a:visited {
        color: #ba6fff;
    }

    .logo {
        filter: brightness(5);
    }

    .highlight {
        .nb, .cp {
            color: #01972c;
        }
        .nt {
            color: #d5b778;
        }
        .cm {
            color: #7a7e85;
        }
        .gd {
            color: #df5959;
        }
        :is(.na, .nf, .s, .s1, .s2) {
            color: #56a8f5;
        }
    }
}

/* Color switch */
.color__switch {
    position: relative;
    cursor: pointer;
    margin: 16px 32px 0 auto;
    font-size: 3.25px;

    height: 8em;
    width: 15em;

    border-radius: 4em;

    transition: all .5s ease;
    background: var(--accent-color);
    box-shadow: inset 0 0 0 2px var(--body-color);

    label {
        position: absolute;
        inset:0;
        cursor: pointer;
        text-indent: -999em;
    }

    input {
        all: unset;
        pointer-events: none;
        position: absolute;
        display: block;
        border-radius: 50%;
        transition: all 0.4s ease-in-out;
        top: 1.5em;
        left: 1.5em;
        transform: rotate(-75deg);
        width: 5em;
        height: 5em;
        background: var(--accent-color);
        box-shadow: 0.75em 0.625em 0 0 #d9fbff inset,
            rgba(255, 255, 255, 0.1) 0 -1.75em 0 -2.25em,
            rgba(255, 255, 255, 0.1) 1.5em 3.5em 0 -2.25em,
            rgba(255, 255, 255, 0.1) 1em 6.5em 0 -2em,
            rgba(255, 255, 255, 0.1) 3em 1em 0 -2.05em,
            rgba(255, 255, 255, 0.1) 4em 4em 0 -2.25em,
            rgba(255, 255, 255, 0.1) 3em 6.5em 0 -2.25em,
            rgba(255, 255, 255, 0.1) -2em 3.6em 0 -2.25em,
            rgba(255, 255, 255, 0.1) -.5em 5em 0 -2.25em;

        &:checked {
            top: 2.25em;
            left: 9em;
            transform: rotate(0deg);
            width: 3.5em;
            height: 3.5em;
            background: #fff;
            box-shadow:
                1.5em 1.5em 0 2.5em #fff inset,
                0 -2.5em 0 -1.35em #fff,
                1.75em -1.75em 0 -1.5em #fff,
                2.5em 0 0 -1.35em #fff,
                1.75em 1.75em 0 -1.5em #fff,
                0 2.5em 0 -1.35em #fff,
                -1.75em 1.75em 0 -1.5em #fff,
                -2.5em 0 0 -1.35em #fff,
                -1.75em -1.75em 0 -1.5em #fff;
        }
    }
}

/* Body */
body {
    font-family: "IBM Plex Sans", sans-serif;
    font-size: 16px;
    line-height: 24px;
    background-color: var(--body-bg);
    color: var(--body-color);
    margin: 0;
    padding: 0;
    padding-bottom: 100px;

    -moz-osx-font-smoothing: grayscale;
    -webkit-font-smoothing: antialiased;
    font-variant-ligatures: none;
    text-rendering: optimizeLegibility;
    -webkit-text-size-adjust: 100%;
}

body.nav-open {
    height: 100vh;
    overflow: hidden;
}

/* Basic Layout */
div.document {
    width: 100%;
    padding: 0 32px;
    margin: 0 auto;
}

div.documentwrapper {
    float: left;
    width: 100%;
}

div.bodywrapper {
    margin: 0 0 0 {{ sidebar_width }};
    padding: 0 0 0 {{ sidebar_gutter_width }};
}

/* Breadcrumb */
div.related {
    width: 100%;
    padding: 0 32px;
    margin: 30px auto;
    font-size: 12px;
    line-height: 16px;
}

div.related li.right:first-child {
    margin-right: 0 !important;
}

div.related ul {
    padding: 0 0 0 {{ sidebar_width }};
    margin-left: {{ sidebar_gutter_width }};
}

/* Sidebar */
div.sphinxsidebar {
    width: {{ sidebar_width }};
    font-size: 12px;
    line-height: 16px;
}

p.logo {
    display: block;
    padding: 5px 0;
}

img.logo {
    height: 34px;
}

div.sphinxsidebarwrapper {
    padding: 0;
}

.sphinxsidebar h3 {
    margin-top: 32px;
    margin-bottom: 8px;
    font-size: 12px;
    line-height: 16px;
    font-weight: bold;
}

div.sphinxsidebar ul {
    padding-left: 0;
    margin-left: 0;
}

div.sphinxsidebar ul ul {
    list-style: circle;
    padding-left: 1.25em;
    margin-left: 0;
}

div.sphinxsidebar input {
    border-color: var(--border-color);
}

div.sphinxsidebar a {
    color: var(--nav-color);
    text-decoration: none;
}

div.sphinxsidebar a:hover {
    color: var(--nav-hover-color);
    text-decoration: underline;
}

div.sphinxsidebar a.current {
    color: var(--nav-hover-color);
}

div.sphinxsidebar li {
    padding-top: 3px;
    padding-bottom: 3px;
    list-style: none;
}

div.sphinxsidebar li ul {
    padding-top: 3px;
}

/* Body */
div.body {
    max-width: 100%;
}

div.body p {
    max-width: 75ch;
}

div.body h1 {
    margin-bottom: 50px;
}

div.body h2,
div.body h3,
div.body h4,
div.body h5,
div.body h6 {
    margin-bottom: 16px;
}

h1 + .section > h2:first-child {
    margin-bottom: 25px;
}

div.body .section {
    margin-bottom: 48px;
}

div.body .section:last-child {
    margin-bottom: 0;
}

/* Toctree */
div.toctree-wrapper {
    font-size: 16px;
    line-height: 22px;
}

.toctree-wrapper li {
    padding-top: 3px;
    padding-bottom: 3px;
}

div.toctree-wrapper li ul {
    padding-top: 3px;
}

div.toctree-wrapper a {
    text-decoration: none;
}

div.toctree-wrapper a {
    color: var(--nav-color);
    text-decoration: none;
}

div.toctree-wrapper a:hover {
    color: var(--nav-hover-color);
    text-decoration: underline;
}

div.toctree-wrapper a.current {
    color: var(--nav-hover-color);
}

/* Mobile */
@media screen and (max-width: 1024px) {
    div.bodywrapper {
        margin: 0;
        padding-left: 0;
    }

    div.sphinxsidebar {
        width: auto;
        margin: 0;
    }

    div.sphinxsidebar .logo {
        display: none;
    }

    div.document,
    div.related {
        max-width: 720px;
    }

    div.related ul {
        padding: 0;
        margin: 0;
    }
}

/* Code highlight */
pre {
    background: var(--code-bg);
    padding: 7px 10px;
    margin: 15px 0;
    line-height: 1.3em;
    font-family: "IBM Plex Mono", monospace;
}

code {
    line-height: 1.3em;
    font-family: "IBM Plex Mono", monospace;
}

.highlight {
    max-width: 75ch;
}

.highlight:hover {
    max-width: 100%;
}

/* admonition */
div.admonition {
    background: var(--admonition-bg);
    margin: 16px 0;
    padding: 16px;
    max-width: 75ch;
}

div.admonition p.admonition-title {
    font-size: 22px;
    line-height: 32px;
}

div.admonition p.last {
    margin-bottom: 0;
}

div.admonition.warning {
    background: var(--warning-bg);
}

div.admonition.caution {
    background: var(--warning-bg);
}

/* Links */
a {
    color: var(--link-color);
    text-decoration: underline;
}

a:hover {
    text-decoration: underline;
}

a.headerlink,
a.headerlink:hover {
    color: var(--link-color);
    text-decoration: none;
}

/* Search */
div.sphinxsidebar #searchbox .search {
    position: relative;
}

div.sphinxsidebar #searchbox input[type="text"] {
    width: 80%;
    height: 30px;
}

div.sphinxsidebar #searchbox input[type="submit"] {
    position: absolute;
    top: 0;
    right: 0;
    width: 20%;
    height: 100%;
}

/* Basics */

ul {
    padding-left: 1.25em;
}

ol {
    padding-left: 1.75em;
}

ul ul,
ul ol,
ol ol,
ol ul {
    margin-top: 0;
    margin-bottom: 0;
}

/* Headlines */
h1, h2, h3, h4, h5, h6 {
    font-family: "IBM Plex Sans", sans-serif;
}

h1 {
    font-size: 42px;
    line-height: 50px;
}

h2 {
    font-size: 32px;
    line-height: 50px;
}

h3 {
    font-size: 24px;
    line-height: 38px;
}

h4 {
    font-size: 22px;
    line-height: 32px;
}

h5 {
    font-size: 20px;
    line-height: 27px;
}

h6 {
    font-size: 20px;
    line-height: 27px;
}

/* Figure */
.align-default,
img.align-default,
figure.align-default,
table.align-default {
    margin-left: 0;
    margin-right: 0;
    padding-left: 0;
    text-align: left;
}

/* Img */
img {
    max-width: 75ch;
}

img.align-center,
figure.align-center,
object.align-center,
img.align-right,
figure.align-right,
object.align-right {
    max-width: 75ch;
    /* not centered */
    margin-left: 0;
    margin-right: 0;
    padding-left: 0;
    padding-right: 0;
}

/* Table */
table {
    width: 100%;
    max-width: 75ch;
}

.sphinxsidebar code,
.toctree-wrapper code
{
    font-weight: inherit;
    font-family: inherit;
}
